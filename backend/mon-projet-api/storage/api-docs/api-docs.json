                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Test trouvé"
                    },
                    "404": {
                        "description": "Test non trouvé"
                    }
                }
            },
            "put": {
                "tags": [
                    "Tests"
                ],
                "summary": "Modifier un test",
                "operationId": "ab4f548be935192551295fba7b6f95d4",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Test modifié"
                    },
                    "404": {
                        "description": "Test non trouvé"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Tests"
                ],
                "summary": "Supprimer un test",
                "operationId": "a45d0482034d370675c1eab805dcda68",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
